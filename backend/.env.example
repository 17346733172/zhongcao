# 可选：SQLite 默认保存在 backend/data/bencao.db。相对路径基于启动工作目录。
# DATABASE_PATH=D:/path/to/bencao.db
# 本地 HTTP 为 false，线上 HTTPS 必须改为 true。
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000

# DeepSeek API Key 仅保存在本机，不提交、不放到前端、不发送到聊天。
# 留空时仍可使用原文检索；配置后重启后端。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 本地 Qwen + FAISS RAG 默认开启，详细配置见 ../code/.env.example 和 ../docs/RAG.md。
# 首次使用先安装依赖、下载模型并运行 code/main.py --rebuild，再重启后端。
RAG_ENABLED=true
# RAG_DATA_PATH=data
# FAISS_PERSIST_DIR=db
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_DEVICE=cpu
# 原始 BF16 权重存储，CPU 逐层使用 FP32 算子，降低常驻内存；fp32 可用于对照。
EMBEDDING_CPU_STORAGE=bf16
# 启动时准备并预热向量模型，完成后才提供 API，避免首条提问承担初始化。
RAG_WARMUP=true
# EMBEDDING_CACHE_DIR=models
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.45
# 内存中最多缓存多少条查询向量，0 为关闭；不缓存 AI 回答。
RAG_QUERY_CACHE_SIZE=128
# 相同账号、问题、上下文和原文的已校验回答短时复用；0 为关闭。
RAG_ANSWER_CACHE_SIZE=16
RAG_ANSWER_CACHE_SECONDS=120
