+import copy
+import json
+import threading
+import time
+import unittest
+from contextlib import contextmanager
+from unittest.mock import patch
+
+from fastapi.testclient import TestClient
+from app.api import create_app
+from app.models import PrescriptionCreate
+from app.processing_defaults import DefaultUpdate, prescription_data, processing_defaults
+from app.service import DomainError, Service
+from app.workflow import initial_state, make_steps
+from tests.postgres import test_schema
+
+
+class MemoryStore:
+    def __init__(self, state=None):
+        self.data = state or initial_state()
+        self.lock = threading.RLock()
+        self.revision = 0
+        self.events = []
+
+    def read(self):
+        return {**copy.deepcopy(self.data), "last_event_id": len(self.events)}
+
+    @contextmanager
+    def transaction(self, *, defer=False):
+        state, events = copy.deepcopy(self.data), []
+        def emit(event_type, entity_id, **payload):
+            events.append((event_type, entity_id, payload))
+            return "2026-11-17T00:00:00Z"
+        yield state, emit
+        self.data = state
+        self.events.extend(events)
+        self.revision += 1
+
+
+def service(store=None):
+    result = Service.__new__(Service)
+    result.store = store or MemoryStore()
+    result.last_wall = time.monotonic()
+    result.snapshot_revision = -1
+    result.cached_snapshot = None
+    return result
+
+
+def prescription(code="fixture", **extra):
+    return PrescriptionCreate(external_no=code, patient_code="SIM", herbs=[{"name": "演示饮片", "grams_per_dose": 10}], **extra)
+
+
+class ProcessingDefaultsTests(unittest.TestCase):
+    def test_update_survives_json_reload_and_changes_dashboard_with_event(self):
+        s = service()
+        s.update_device_default("dispenser", DefaultUpdate(default_processing_seconds=450, expected_revision=0))
+        restored = service(MemoryStore(json.loads(json.dumps(s.store.data))))
+        self.assertEqual(restored.device_defaults()["revision"], 1)
+        self.assertEqual(next(i for i in restored.dashboard()["devices"] if i["kind"] == "dispenser")["default_processing_seconds"], 450)
+        self.assertEqual(s.store.events[-1][0], "device.defaults_updated")
+
+    def test_revision_conflict_and_pot_reject_without_state_change(self):
+        s = service()
+        s.update_device_default("dispenser", DefaultUpdate(default_processing_seconds=450, expected_revision=0))
+        before = copy.deepcopy(s.store.data)
+        for kind in ("dispenser", "pot"):
+            with self.assertRaises(DomainError):
+                s.update_device_default(kind, DefaultUpdate(default_processing_seconds=300, expected_revision=0))
+        self.assertEqual(s.store.data, before)
+
+    def test_existing_batch_frozen_new_batch_uses_new_fixed_default(self):
+        s = service()
+        def batch(code):
+            p = s.create_prescription(prescription(code))
+            s.store.data["prescriptions"][p["id"]]["status"] = "approved"
+            return s.create_batch(p["id"])
+        old = batch("before")
+        s.update_device_default("dispenser", DefaultUpdate(default_processing_seconds=450, expected_revision=0))
+        new = batch("after")
+        self.assertEqual(s.batch(old["id"])["steps"][0]["duration_seconds"], 600)
+        self.assertEqual(new["steps"][0]["duration_seconds"], 450)
+
+    def test_soaking_and_decoction_defaults_respect_explicit_recipe(self):
+        defaults = processing_defaults({"processing_defaults": {"soaking": 60, "decocter": 90}})
+        auto = prescription_data(prescription(), defaults)
+        self.assertEqual(auto["recipe"]["soak_seconds"], 60)
+        self.assertEqual(auto["recipe"]["first_decoct_seconds"], 90)
+        self.assertLess(auto["recipe"]["late_add_seconds"], 90)
+        explicit = prescription_data(prescription(recipe={"soak_seconds": 20, "first_decoct_seconds": 45, "second_decoct_seconds": 0}), defaults)
+        self.assertEqual(explicit["recipe"]["soak_seconds"], 20)
+        self.assertEqual(explicit["recipe"]["second_decoct_seconds"], 0)
+        self.assertEqual(next(step for step in make_steps(explicit, defaults) if step["code"] == "first_decoct")["duration_seconds"], 45)
+
+    def test_authenticated_api_and_validation(self):
+        with patch("app.api.Service", return_value=service()):
+            with TestClient(create_app(api_key="fixture-key", enable_runner=False)) as client:
+                path = "/api/v1/device-defaults/dispenser"
+                self.assertEqual(client.post(path, json={}).status_code, 401)
+                headers = {"X-API-Key": "fixture-key"}
+                for value in (0, 5, 7201, True, "300"):
+                    self.assertEqual(client.post(path, headers=headers, json={"default_processing_seconds": value, "expected_revision": 0}).status_code, 422)
+                result = client.post(path, headers=headers, json={"default_processing_seconds": 450, "expected_revision": 0})
+                self.assertEqual(result.status_code, 200)
+                self.assertEqual(result.json()["revision"], 1)
+                self.assertEqual(len(result.json()["items"]), 13)
+
+    def test_postgres_restart_preserves_defaults(self):
+        dsn = test_schema(self)
+        s = Service(dsn)
+        s.update_device_default("dispenser", DefaultUpdate(default_processing_seconds=450, expected_revision=0))
+        self.assertEqual(Service(dsn).device_defaults()["revision"], 1)
+
+    def test_cached_scheduler_persists_default_and_preserves_existing_steps(self):
+        dsn = test_schema(self)
+        s = Service(dsn, cache_state=True)
+        old_prescription = s.create_prescription(prescription("before"))
+        from app.models import Review
+        s.review(old_prescription["id"], Review(approved=True, operator="SIM-QA", comment="演示"))
+        old = s.create_batch(old_prescription["id"])
+        s.update_device_default("dispenser", DefaultUpdate(default_processing_seconds=450, expected_revision=0))
+        restored = Service(dsn)
+        self.assertEqual(restored.device_defaults()["revision"], 1)
+        self.assertEqual(restored.batch(old["id"])["steps"][0]["duration_seconds"], 600)
+        self.assertEqual(next(item for item in restored.dashboard()["devices"] if item["kind"] == "dispenser")["default_processing_seconds"], 450)
+        self.assertEqual(restored.store.events(event_type="device.defaults_updated")[-1]["payload"]["revision"], 1)
+
+    def test_database_revision_serializes_concurrent_updates(self):
+        dsn = test_schema(self)
+        first, second = Service(dsn), Service(dsn)
+        barrier = threading.Barrier(2)
+        results = []
+        def update(s, seconds):
+            barrier.wait()
+            try:
+                s.update_device_default("dispenser", DefaultUpdate(default_processing_seconds=seconds, expected_revision=0))
+                results.append("saved")
+            except DomainError as error:
+                results.append(error.code)
+        threads = [threading.Thread(target=update, args=(s, value)) for s, value in ((first, 450), (second, 480))]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=15)
+            self.assertFalse(thread.is_alive())
+        self.assertCountEqual(results, ["saved", "defaults_changed"])
+        self.assertEqual(Service(dsn).device_defaults()["revision"], 1)
