+"""Persistent simulator defaults; explicit prescription recipe fields take priority."""
+
+from fastapi import APIRouter
+from pydantic import Field
+
+from .models import Model, PrescriptionCreate
+from .workflow import DEFAULT_PROCESSING_SECONDS, DEVICE_LABELS
+
+
+class DefaultUpdate(Model):
+    default_processing_seconds: float = Field(strict=True, ge=6, le=7200)
+    expected_revision: int = Field(strict=True, ge=0)
+
+
+def processing_defaults(state):
+    return {**DEFAULT_PROCESSING_SECONDS, **state.get("processing_defaults", {})}
+
+
+def defaults_page(state):
+    return {"items": [{"kind": str(kind), "name": DEVICE_LABELS[kind], "default_processing_seconds": seconds}
+                      for kind, seconds in processing_defaults(state).items()],
+            "revision": state.get("processing_defaults_revision", 0)}
+
+
+def prescription_data(request, defaults):
+    data = request.model_dump()
+    recipe = data["recipe"]
+    fields = request.recipe.model_fields_set
+    for field, kind in (("soak_seconds", "soaking"), ("pre_decoct_seconds", "decocter"),
+                        ("first_decoct_seconds", "decocter"), ("second_decoct_seconds", "decocter")):
+        if field not in fields:
+            recipe[field] = defaults[kind]
+    if "late_add_seconds" not in fields and recipe["late_add_seconds"] >= recipe["first_decoct_seconds"]:
+        recipe["late_add_seconds"] = min(300, recipe["first_decoct_seconds"] / 3)
+    return PrescriptionCreate.model_validate(data).model_dump()
+
+
+def register_default_routes(router: APIRouter, service):
+    @router.get("/device-defaults", tags=["设备"], summary="读取设备分类默认每次用时")
+    def defaults():
+        return service.device_defaults()
+
+    @router.post("/device-defaults/{kind}", tags=["设备"], summary="保存设备分类默认用时，仅影响之后创建的数据")
+    def update(kind: str, body: DefaultUpdate):
+        return service.update_device_default(kind, body)
